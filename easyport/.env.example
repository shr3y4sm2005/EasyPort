# EasyPort Environment Configuration Template
# Copy this to .env for local development
# For Railway deployment, set these as environment variables in the Railway dashboard

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-super-secure-secret-key-change-this-in-production

# Database (Railway will automatically provide DATABASE_URL for PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/database

# Server Configuration
# PORT=5000  # Railway will set this automatically

# Feature Flags
PROVIDER_API_ENABLED=false

# Security Settings
SESSION_COOKIE_SECURE=true  # Set to false for local development over HTTP
WTF_CSRF_ENABLED=true

# Rate Limiting
# REDIS_URL=redis://localhost:6379  # For Redis-based rate limiting (optional)

# Logging
LOG_LEVEL=WARNING  # Use INFO or DEBUG for development

# External APIs
NOMINATIM_USER_AGENT=easyport/1.0 (contact: your-email@example.com)

# Cache Configuration (optional overrides)
# GEOCODE_CACHE_TIMEOUT=3600
# QUOTES_CACHE_TIMEOUT=60